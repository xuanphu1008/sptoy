<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hop dong dich vu SOAP cho doi tac ToyLand (contract-first): WSDL duoc sinh tu luoc do nay.
  Dich vu chi doc: tra cuu hang dang ban va ton kho theo ma SKU.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://toyland.vn/soap/partner"
           targetNamespace="http://toyland.vn/soap/partner"
           elementFormDefault="qualified">

  <!-- Tieu de SOAP xac thuc: apiKey + timestamp (giay Unix) + signature = hex(HMAC-SHA256(secret, timestamp \n tenThaoTac \n sku)) -->
  <xs:element name="Auth">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="apiKey" type="xs:string"/>
        <xs:element name="timestamp" type="xs:long"/>
        <xs:element name="signature" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Kieu co rang buoc: may chu tu choi yeu cau sai dinh dang truoc khi vao nghiep vu -->
  <xs:simpleType name="Sku">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="60"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OrderCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="TL[0-9]{10,20}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="GetStockRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="tns:Sku"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetStockResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="xs:string"/>
        <xs:element name="available" type="xs:int"/>
        <xs:element name="inStock" type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetProductRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="tns:Sku"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetProductResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sku" type="xs:string"/>
        <xs:element name="productName" type="xs:string"/>
        <xs:element name="category" type="xs:string" minOccurs="0"/>
        <xs:element name="brand" type="xs:string" minOccurs="0"/>
        <xs:element name="price" type="xs:decimal"/>
        <xs:element name="stock" type="xs:int"/>
        <xs:element name="imageUrl" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Tra trang thai don hang do chinh doi tac dat (don cua doi tac khac coi nhu khong ton tai) -->
  <xs:element name="GetOrderStatusRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="orderCode" type="tns:OrderCode"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetOrderStatusResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="orderCode" type="xs:string"/>
        <xs:element name="externalRef" type="xs:string" minOccurs="0"/>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="statusLabel" type="xs:string"/>
        <xs:element name="paymentStatus" type="xs:string"/>
        <xs:element name="total" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
